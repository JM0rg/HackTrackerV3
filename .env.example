# Supabase credentials for the Node database-introspection scripts (scripts/database/*).
# Copy to `.env` and fill in. NEVER commit the real .env.
# The Flutter app does NOT read this file — it takes SUPABASE_URL / SUPABASE_ANON_KEY
# via --dart-define at build/run time (see README).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_PASSWORD=
