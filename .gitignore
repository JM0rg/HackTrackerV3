# Secrets — never commit
.env
.env.*
!.env.example

# Node (database/CI scripts)
node_modules/
npm-debug.log*

# macOS
.DS_Store

# Editor / IDE
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code local-only settings
.claude/settings.local.json

# Python cache (CI helpers)
__pycache__/
*.pyc

# Flutter/Dart build artifacts are ignored by app/.gitignore (generated by `flutter create`)
